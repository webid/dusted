{
  "manifest_version": 3,
  "name": "Dusted: Dust Protocol Optimizer",
  "version": "1.0",
  "description": "Automate 'Dust Protocol' on Etherlink Shadownet using the Shredder strategy.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://dustprotocol.pages.dev/*",
    "https://node.shadownet.etherlink.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Dust Optimizer",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dustprotocol.pages.dev/*"
      ],
      "js": [
        "break_infinity.js",
        "content.js"
      ]
    }
  ]
}